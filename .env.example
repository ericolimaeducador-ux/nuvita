# ============================================
# NUVITA API - Environment Configuration
# ============================================
# SECURITY NOTICE: Never commit actual secrets to git
# Use .env.local for development (add to .gitignore)
# Use Google Secret Manager in production
# Rotate secrets quarterly (HIPAA/LGPD requirement)
#

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3000
# NODE_ENV controla a POSTURA DE SEGURANÇA (independente da fonte de segredos):
#   production => Swagger fechado, CSP ligado, HSTS, logs sane.
#   development => Swagger aberto e CSP relaxado para DX local.
NODE_ENV=development
# CONFIG_SOURCE controla DE ONDE os segredos vêm, independente do NODE_ENV:
#   env => variáveis de ambiente (este arquivo / --env-vars-file do Cloud Run).
#   gcp => Google Secret Manager.
# Vazio => auto: production/staging usa gcp, senão env. Para rodar produção sem
# provisionar o Secret Manager, defina NODE_ENV=production e CONFIG_SOURCE=env.
CONFIG_SOURCE=env
# EXPOSE_DOCS=true reabre o Swagger /docs mesmo em produção (ex.: staging protegido).
# EXPOSE_DOCS=false
# ALLOW_PUBLIC_REGISTRATION controla o /auth/register público (cria contas
# PACIENTE sem clínica). Em produção fica DESABILITADO por padrão; habilite
# explicitamente apenas se o produto precisar de auto-cadastro de pacientes.
# ALLOW_PUBLIC_REGISTRATION=false
CORS_ORIGIN=http://localhost:5173,http://localhost:3001

# ============================================
# DATABASE CONFIGURATION
# ============================================
# DESENVOLVIMENTO NUNCA deve usar o banco de produção. Se o desenvolvimento local apontar
# para o mesmo cluster Atlas da produção, use um banco de NOME DIFERENTE (o nome fica no
# fim da URI): produção = .../nuvita   |   desenvolvimento = .../nuvita-dev
# (dados de teste, como pedidos de pagamento, nunca devem ser gravados no banco de produção).
MONGODB_URI=mongodb://localhost:27017/nuvita
REDIS_URL=redis://localhost:6379

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
BCRYPT_ROUNDS=12
TOTP_ISSUER=Nuvita

# ============================================
# PATIENT DATA ENCRYPTION (LGPD/HIPAA CRITICAL)
# ============================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PATIENT_DATA_ENCRYPTION_KEY=your-base64-encoded-32-bytes-here
PATIENT_DATA_HASH_KEY=your-optional-base64-encoded-32-bytes

# ============================================
# DOCUMENT STORAGE (S3 or Cloudflare R2)
# ============================================
DOCUMENT_STORAGE_BUCKET=nuvita-documentos
DOCUMENT_STORAGE_REGION=auto
DOCUMENT_STORAGE_ENDPOINT=https://YOUR-ACCOUNT.r2.cloudflarestorage.com
DOCUMENT_STORAGE_FORCE_PATH_STYLE=true
DOCUMENT_STORAGE_ACCESS_KEY_ID=your-access-key-id
DOCUMENT_STORAGE_SECRET_ACCESS_KEY=your-secret-access-key

# ============================================
# EMAIL NOTIFICATIONS
# ============================================
EMAIL_PROVIDER=resend
EMAIL_FROM=no-reply@nuvita.com.br
RESEND_API_KEY=re_your_api_key_here

# ============================================
# WHATSAPP NOTIFICATIONS (Optional)
# ============================================
WHATSAPP_PROVIDER=evolution
EVOLUTION_API_URL=https://evolution.sua-empresa.com
EVOLUTION_INSTANCE=nuvita
EVOLUTION_API_KEY=your-evolution-api-key

# ============================================
# SMS NOTIFICATIONS (Optional)
# ============================================
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM=+5511999999999

# ============================================
# PRONTUÁRIO & MULTI-TENANCY
# ============================================
PRONTUARIO_SIGNATURE_SECRET=long-random-secret-for-digital-signatures
APP_ROOT_DOMAIN=nuvita.com.br
BOOTSTRAP_SECRET=change-in-production

# ============================================
# GOOGLE CLOUD PLATFORM (GCP)
# ============================================
GCP_PROJECT_ID=nuvita-499800
KMS_KEY_RING=nuvita-keyring
KMS_KEY=nuvita-master-key

# ============================================
# SECRETS MANAGER
# ============================================
# In production: gcp-secret-manager
# In development: local-env (this file)
SECRETS_BACKEND=local-env

# ============================================
# IA (pré-preenchimento do Relatório Médico Judiciário)
# ============================================
# Opcional: sem a chave, o botão "Pré-preencher com IA" falha com mensagem
# clara e o resto do formulário continua funcionando normalmente.
# Use uma chave de projeto Google com faturamento ativo (tier pago), não a
# chave gratuita do AI Studio, antes de usar em produção (dados de saúde).
GEMINI_API_KEY=your-gemini-api-key

# ============================================
# MERCADO PAGO (checkout transparente / Wallet Brick)
# ============================================
# Access Token: SEGREDO de servidor. Nunca no frontend, nunca em log, nunca commitado.
# Use o token de TESTE em dev; o de produção só no ambiente de produção.
MERCADO_PAGO_ACCESS_TOKEN=
# Chave secreta do webhook (painel do Mercado Pago > Webhooks). Obrigatória em produção:
# sem ela o webhook é recusado. Em dev, sem ela a assinatura não é verificada.
MERCADO_PAGO_WEBHOOK_SECRET=
# URL pública HTTPS do webhook (ex.: https://api.seudominio.com/pagamentos/webhook).
# Opcional se a URL já estiver cadastrada no painel do Mercado Pago.
MERCADO_PAGO_NOTIFICATION_URL=
# Frontend (apps/web/.env.local, NÃO neste arquivo): VITE_MERCADO_PAGO_PUBLIC_KEY=<public key>
# Túnel de teste e passo a passo: docs/checkout-mercado-pago.md

# ============================================
# LOGGING & MONITORING
# ============================================
LOG_LEVEL=debug
